# Google Analytics (optional override for App.jsx dynamic loader)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification code
# 1. Go to https://search.google.com/search-console
# 2. Add property: https://up4growth.ch
# 3. Choose "HTML tag" verification
# 4. Copy only the content value (not the full meta tag) into the line below
VITE_GSC_VERIFICATION=your-google-verification-code

# Bing Webmaster Tools verification (optional)
VITE_BING_VERIFICATION=your-bing-verification-code
